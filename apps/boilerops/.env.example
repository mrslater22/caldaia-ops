# BoilerOps — local development

# Required for signed session cookies (min 32 characters)
AUTH_SECRET=change-me-to-a-long-random-string-for-dev

# Super admin credentials (POC only — replace with Supabase Auth later)
SUPER_ADMIN_EMAIL=admin@caldaiacontrols.com
SUPER_ADMIN_PASSWORD=change-me-now

# App URL (used when generating QR code links)
# Production: https://boilerops.caldaiacontrols.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=reports
SUPABASE_QR_BUCKET=qr-codes

# FastField inbound webhooks (POST /api/fastfield/submissions and
# POST /api/fastfield/sample). Required in every environment, including
# local development and Vercel Preview/Production.
# Generate a unique random value per environment. FastField must send that
# exact value on each request in the x-boilerops-secret header, or as the
# HTTP Basic password. Also accepted: x-api-key and x-fastfield-secret.
# Do not put the secret in the webhook URL. Requests are rejected when this
# is empty. The server log never includes the secret or the value received.
FASTFIELD_WEBHOOK_SECRET=

# Local development only. Ignored when NODE_ENV=production.
# Set to true to accept inbound FastField webhooks while
# FASTFIELD_WEBHOOK_SECRET is unset. Leave this commented out unless you
# explicitly want that bypass. A configured secret is always required.
# FASTFIELD_WEBHOOK_ALLOW_INSECURE_DEV=true

# FastField API credentials for the legacy site-row projector
# (fastfield_data_tables.sync_url). Data Table IDs, endpoints, methods, and
# those field mappings are stored in public.fastfield_data_tables.
FASTFIELD_API_KEY=
FASTFIELD_SESSION_TOKEN=
FASTFIELD_API_KEY_HEADER=x-api-key
FASTFIELD_SESSION_TOKEN_HEADER=x-session-token

# DataTables API v3 upsert of the FastField table "site info" from submission
# fields. Default off. This does not run, and does not change ingest, until
# FASTFIELD_SITE_INFO_SYNC_ENABLED=true AND the key column and field map are
# set. Michael must fill those in. See docs/fastfield-site-info-sync.md.
# Do not put real secrets in git.
# FASTFIELD_SITE_INFO_SYNC_ENABLED=true
# Same values that already authorize GET submissions. Not the webhook secret.
# FASTFIELD_SUBSCRIPTION_KEY=
# FASTFIELD_USER_TOKEN=
# X-Gatekeeper-SessionToken is the only header named on the DataTables PDFs.
# Its relationship to the Bearer user token is unknown. Leave unset to omit
# the header. Set to bearer to send FASTFIELD_USER_TOKEN again in that
# header. Any other value is sent as the header itself.
# FASTFIELD_GATEKEEPER_SESSION_TOKEN=
# FASTFIELD_DATATABLES_BASE_URL=https://api.fastfieldforms.com/services/v3
# Exact table name from GET /datatables/list. Default in code is "site info".
# FASTFIELD_SITE_INFO_TABLE_NAME=site info
# Exact site-info column display name that identifies one site. Unknown.
# FASTFIELD_SITE_INFO_KEY_COLUMN=
# JSON object: column display name -> submission field key. Unknown.
# Example shape only: {"REPLACE_WITH_COLUMN":"REPLACE_WITH_SUBMISSION_FIELD"}
# FASTFIELD_SITE_INFO_FIELD_MAP=

