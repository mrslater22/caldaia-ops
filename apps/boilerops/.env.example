# BoilerOps — local development

# Required for signed session cookies (min 32 characters)
AUTH_SECRET=change-me-to-a-long-random-string-for-dev

# Super admin credentials (POC only — replace with Supabase Auth later)
SUPER_ADMIN_EMAIL=admin@caldaiacontrols.com
SUPER_ADMIN_PASSWORD=change-me-now

# App URL (used when generating QR code links)
# Production: https://boilerops.caldaiacontrols.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=reports
SUPABASE_QR_BUCKET=qr-codes

# FastField (for upcoming onboarding webhook)
# FastField API credentials (optional — for future form schema sync)
FASTFIELD_API_KEY=
FASTFIELD_SESSION_TOKEN=

