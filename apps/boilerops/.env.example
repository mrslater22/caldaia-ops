# BoilerOps — local development

# Required for signed session cookies (min 32 characters)
AUTH_SECRET=change-me-to-a-long-random-string-for-dev

# Super admin credentials (POC only — replace with Supabase Auth later)
SUPER_ADMIN_EMAIL=admin@caldaiacontrols.com
SUPER_ADMIN_PASSWORD=change-me-now

# App URL (used when generating QR code links)
# Production: https://boilerops.caldaiacontrols.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=reports
SUPABASE_QR_BUCKET=qr-codes

# FastField inbound webhooks (POST /api/fastfield/submissions and
# POST /api/fastfield/sample). Required in every environment, including
# local development and Vercel Preview/Production.
# Generate a unique random value per environment. FastField must send that
# exact value on each request in the x-boilerops-secret header, or as the
# HTTP Basic password. Also accepted: x-api-key and x-fastfield-secret.
# Do not put the secret in the webhook URL. Requests are rejected when this
# is empty. The server log never includes the secret or the value received.
FASTFIELD_WEBHOOK_SECRET=

# Local development only. Ignored when NODE_ENV=production.
# Set to true to accept inbound FastField webhooks while
# FASTFIELD_WEBHOOK_SECRET is unset. Leave this commented out unless you
# explicitly want that bypass. A configured secret is always required.
# FASTFIELD_WEBHOOK_ALLOW_INSECURE_DEV=true

# FastField API credentials. Data Table IDs, endpoints, methods, and field
# mappings are stored in public.fastfield_data_tables.
FASTFIELD_API_KEY=
FASTFIELD_SESSION_TOKEN=
FASTFIELD_API_KEY_HEADER=x-api-key
FASTFIELD_SESSION_TOKEN_HEADER=x-session-token

